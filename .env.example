## AnyWhere signaling-server (example)
## Copy to `.env` locally or set these in Railway.

# Server
HOST=0.0.0.0
PORT=18085
# Set to true in ALL production deployments (required for WSS)
ENFORCE_TLS=true

# Concurrent screen streaming (audit grid + multiple auditors)
# MAX_ADMIN_VIEWER_TARGETS=24
# MAX_VIEWERS_PER_CLIENT=5
# SIGNALING_RATE_CAPACITY=200
# SIGNALING_RATE_REFILL_PER_SEC=80

# Ingest auth (server-minted token for client HTTP ingest)
# Set these in production (Railway). Never commit real secrets.
INGEST_TOKEN_SECRET=REPLACE_ME_LONG_RANDOM
INGEST_TOKEN_TTL_MS=900000
# Optional: if set, enables ephemeral TURN credentials (recommended for production)
# Must match the static-auth-secret configured in coturn
TURN_SECRET=your_shared_secret_here

# Optional: allow unauthenticated ingest in local-dev only (NOT for production)
# ALLOW_CALL_EVENTS_WITHOUT_TOKEN=false

# Optional DB path for local SQLite (current implementation)
# DB_PATH=./signaling.db

# Supabase / Postgres (set real values only in Railway or local `.env` — never commit secrets)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Use SSL for production poolers when required:
# SUPABASE_REQUIRE_SSL=true
# PGSSLMODE=require

# Optional Postgres tuning
# PG_CONNECT_TIMEOUT_MS=10000
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000

# Optional: lock down allowed browser origins (comma-separated). Empty = allow all.
# ALLOWED_ORIGINS=http://10.80.80.221:13000,http://localhost:5173

# Cloudflare Realtime TURN — server-side only (minted per WebSocket via API; never commit real tokens)
# dash.cloudflare.com → Realtime → TURN → Create app → Turn Token ID + API Token
ICE_TURN_SOURCE=cloudflare
CLOUDFLARE_TURN_KEY_ID=paste_turn_token_id_here
CLOUDFLARE_TURN_KEY_API_TOKEN=paste_api_token_here
# When ICE_TURN_SOURCE=cloudflare, home TURN_* below are optional (fallback if API fails)

# Browser / taskbar / extension (BrowserScope) activity — default ON (ingest + WS broadcast to audit).
# Set to 0 or false only if you intentionally disable extension/tab telemetry.
# ENABLE_APP_ACTIVITY_TELEMETRY=false
# Real-time fast lane for browser tabs:
# - true (default): persist to browser_tab_events + WS broadcast
# - false: WS broadcast + in-memory latest snapshot only (skip DB writes for lower latency)
# BROWSER_TAB_PERSIST_TO_DB=false

# Extension / BrowserScope snapshots are stored in Postgres `browser_tab_events` only (tabs_json, session_json, etc.).
# Rolling retention by server ingest time — does not delete call_events, taskbar_events, or other tables.
# BROWSER_TAB_RETENTION_DAYS=7
# Set to 0 to never auto-delete extension rows (not recommended; DB will grow).
# BROWSER_TAB_RETENTION_INTERVAL_MS=21600000
# Optional: app telemetry controls (taskbar + browser tab ingest/broadcast)
# ENABLE_APP_ACTIVITY_TELEMETRY=true
# ENABLE_TASKBAR_TELEMETRY=false
# ENABLE_TASKBAR_INGEST_LOGS=false

# Optional: proxy audit-dashboard super-admin API for Electron (admin-audit-org-access-* WS messages).
# Same AUDIT_SUPERADMIN_SERVICE_SECRET as on the audit-dashboard Railway service.
# On Railway: use the public audit HTTPS URL (not localhost).
# AUDIT_DASHBOARD_URL=https://stunning-octo-umbrella-production-f5bc.up.railway.app
# AUDIT_SUPERADMIN_SERVICE_SECRET=REPLACE_ME_LONG_RANDOM
# Audit on same host as signaling: AUDIT_DASHBOARD_URL=http://10.80.80.221:13000
